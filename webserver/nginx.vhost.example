# Example HOST Nginx vhost for a Docker-backed MCP server.
# Copy to /etc/nginx/sites-available/mcp.example.com and replace the hostname.
# Certbot --nginx will add HTTPS configuration to this file.
# Do not expose 127.0.0.1:4444 publicly and do not proxy /mcp alone.

server {
    listen 80;
    listen [::]:80;
    server_name mcp.example.com;

    location / {
        proxy_pass http://127.0.0.1:4444;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 16k;
    }
}
