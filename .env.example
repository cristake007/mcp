# Public HTTPS origin, without a trailing slash or /mcp.
PUBLIC_BASE_URL=https://mcp.cursurituv.ro

# Set strong random password. Example: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Used to bind the login form to its OAuth transaction. openssl rand -hex 32
LOGIN_COOKIE_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
