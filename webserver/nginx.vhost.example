# HTTP-only bootstrap example: for production HTTPS use Certbot, then add
# 'include /etc/nginx/snippets/mcp-hardening.inc;' inside the TLS server {}.
# Keep the existing catch-all location and Certbot-managed directives.
server {
    listen 80;
    listen [::]:80;
    server_name mcp.example.com;

    include /etc/nginx/snippets/mcp-hardening.inc;
    location / {
        client_max_body_size 2m;
        include /etc/nginx/snippets/mcp-proxy.inc;
    }
}
