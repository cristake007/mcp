# Independent from the root MCP .env; generate your own random secret.
RAG_DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# Set to 0 for indexing/searching without the local embedding model.
RAG_EMBEDDINGS_ENABLED=1
# Only used when you explicitly enable MCP integration via compose.mcp.yaml
# Generate using: openssl rand -hex 32
RAG_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional automatic indexer settings (standalone Docker container).
# Poll the documents directory once per 60 seconds.
RAG_SCAN_INTERVAL_SECONDS=60
# Do not index a newly copied file until its size/mtime are stable twice
# and its modification time is at least 20 seconds old.
RAG_SETTLE_SECONDS=20
# When files are removed from a nonempty stable folder, remove their index.
# Set 0 if deleted files should remain searchable.
RAG_AUTO_PRUNE=1
