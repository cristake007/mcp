# Public HTTPS origin, without a trailing slash or /mcp.
PUBLIC_BASE_URL=https://mcp.cursurituv.ro

# Set strong random password. Example: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Used to bind the login form to its OAuth transaction. openssl rand -hex 32
LOGIN_COOKIE_KEY=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

# Optional during testing, REQUIRED before using sensitive data in production.
# Run: docker compose exec mcp python -m app.manage list-clients
# Use only the exact callback hostnames observed for trusted clients.
# E.g. OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,127.0.0.1
# OAUTH_ALLOWED_REDIRECT_HOSTS=
